<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:enforceNavigationBarContrast" tools:targetApi="29">true</item>
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">#ffffff</item>
    <!-- Ensure system navigation bar has a dark background and light icons -->
    <item name="android:navigationBarColor">#000000</item>
    <item name="android:navigationBarDividerColor">#000000</item>
    <!-- false -> navigation bar icons will be light on dark background (API 26+) -->
    <item name="android:windowLightNavigationBar">false</item>
    <!-- let the app draw system bar backgrounds -->
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
  </style>
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/ic_launcher_background</item>
  </style>
</resources>